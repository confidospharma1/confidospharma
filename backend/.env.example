# ==============================================================================
# Confidos Pharma Enterprise OS - Backend Environment Configuration (.env.example)
# ==============================================================================
# In production (e.g. Render), configure these variables in the Render Dashboard
# under your Web Service -> Environment -> Environment Variables.
# NEVER commit your actual .env file or real database credentials to GitHub.

# Database Connections (PostgreSQL / Neon Serverless)
# DATABASE_URL: Pooled connection string (PgBouncer, includes '-pooler') for high-concurrency API queries
DATABASE_URL="postgresql://username:password@ep-divine-art-b5xka9pz-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct connection string (Direct compute, host WITHOUT '-pooler') for Prisma schema push & migrations
DIRECT_URL="postgresql://username:password@ep-divine-art-b5xka9pz.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security (generate a random 32+ character string)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# Frontend CORS Allowed Origin
FRONTEND_URL="http://localhost:3000"

# Optional: Demo database seeding flag (defaults to false to preserve production databases)
ALLOW_DEMO_SEED=false
